# Copy this file to .streamlit/secrets.toml (on your computer)
# or paste it into Streamlit Cloud → your app → Settings → Secrets.
# Never upload the real secrets.toml to GitHub.

# Protects your free credits: anyone opening the app must enter this password.
APP_PASSWORD = "choose-a-strong-password"

# Bright Data — 5,000 free credits / month (resets on the 1st)
BRIGHTDATA_API_KEY = ""
BRIGHTDATA_ZONE = "serp_api1"

# SerpApi — Free plan: 250 searches / month, 50 / hour
SERPAPI_KEY = ""

# Serper — 2,500 free queries on sign-up
SERPER_API_KEY = ""

# Google Search Console (optional) — open your JSON key file in Notepad,
# copy EVERYTHING inside it, and paste it between the three quotes below.
GSC_JSON = '''
{ paste the whole JSON file here }
'''
